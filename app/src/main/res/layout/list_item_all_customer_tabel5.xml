<?xml version="1.0" encoding="utf-8"?>
    <com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/layout_commit_documents"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         app:cardBackgroundColor="@color/actionbar_text_color"
        app:layout_gravity="center"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="1dp"
        android:translationZ="1dp"
        android:animateLayoutChanges="true"
        app:strokeColor="#CFCCCC"
        app:strokeWidth="1dp"
        android:layout_margin="2dp"
        android:padding="2dp"
        tools:context=".Tabels.Peoples.MainActivity_List_Peoples">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="left|top"
        android:foregroundGravity="top"
        android:layout_gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_alignParentTop="true"
        android:baselineAligned="true"
        android:divider="@color/accent"
        android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ImageViewPeople"
                                android:layout_width="50dp"
                                android:layout_height="80dp"
                                android:layout_margin="2dp"
                                android:padding="2dp"
                                android:animateLayoutChanges="true"
                                android:background="@drawable/stylesingletablerowiine7"
                                android:gravity="center"
                                android:visibility="visible"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:srcCompat="@drawable/icon_for_eople_listtabel1"
                                app:strokeColor="#F5FFFA" />


                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/MaterialTextViewPeople"
                                    android:layout_weight="1"
                                    android:layout_width="240dp"
                                    android:layout_height="80dp"
                                    android:layout_margin="2dp"
                                    android:padding="1dp"
                                    android:animateLayoutChanges="true"
                                    android:background="@drawable/stylesingletablerowiine7"
                                    android:checkMark="?android:attr/textCheckMark"
                                    android:foregroundGravity="center"
                                    android:gravity="center"
                                    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                                    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
                                    android:text="фио"
                                    android:hint="фио"
                                    android:textAlignment="gravity"
                                    android:textAppearance="?android:attr/textAppearanceListItemSmall"
                                    android:textColor="#000000"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:visibility="visible"
                                    app:cardCornerRadius="20dp"
                                    android:tooltipText="фио"
                                    app:cardElevation="10dp"
                                    app:strokeColor="#F5FFFA" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/MaterialTextViewPeopeChasy"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="2dp"
        android:padding="1dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/stylesingletablerowiine7"
        android:checkMark="?android:attr/textCheckMark"
        android:foregroundGravity="center"
        android:gravity="center"
        android:paddingStart="?android:attr/listPreferredItemPaddingStart"
        android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
        android:hilt="смена"
        android:text="смена"
        android:textAlignment="gravity"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cardCornerRadius="20dp"
        android:tooltipText="смена"
        app:cardElevation="10dp"
        app:strokeColor="#F5FFFA" />


</LinearLayout>
    </com.google.android.material.card.MaterialCardView>














